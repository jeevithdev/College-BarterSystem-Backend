# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 ENHANCED SECURITY CONFIGURATION FOR VALRIX BACKEND
# ═══════════════════════════════════════════════════════════════════════════════
#
# ⚠️  SECURITY WARNING: Generate cryptographically secure secrets in production!
#     Use Node.js: crypto.randomBytes(32).toString('hex')
#     Or OpenSSL:  openssl rand -hex 32
#

# ─── Enhanced JWT Configuration ───────────────────────────────────────────
# 🔑 JWT secrets MUST be 256-bit (64 hex characters) for maximum security
JWT_ACCESS_SECRET=your_cryptographically_secure_64_character_access_secret_here_min_64_chars_required
JWT_REFRESH_SECRET=your_cryptographically_secure_64_character_refresh_secret_here_min_64_chars_required

# JWT token expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Legacy JWT secret (deprecated - remove after full migration)
JWT_SECRETKEY=your_strong_random_secret_here_min_32_chars

# ─── MongoDB Configuration ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Redis Configuration ──────────────────────────────────────────────────
# 🚀 Redis for rate limiting, session storage, and caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here_optional
REDIS_DB=0

# Alternative Redis URL format (takes precedence if set)
REDIS_URL=redis://localhost:6379

# ─── Server Configuration ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Security Policies ────────────────────────────────────────────────────
# 🔐 Enhanced password security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
REQUIRE_PASSWORD_COMPLEXITY=true

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=30

# ─── File Upload Security ─────────────────────────────────────────────────
# 📁 Reduced file size limits for DoS protection
MAX_JSON_SIZE=1mb
MAX_IMAGE_SIZE_BYTES=2097152
MAX_DOCUMENT_SIZE_BYTES=5242880
MAX_FILE_SIZE_BYTES=1048576

# ─── CORS Configuration ───────────────────────────────────────────────────
# 🌐 Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# ─── Email Configuration (SMTP) ───────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# ─── Two-Factor Authentication ────────────────────────────────────────────
# 🔐 TOTP-based 2FA configuration
TWO_FACTOR_ISSUER=Valrix
TWO_FACTOR_WINDOW=2

# ─── Push Notifications ───────────────────────────────────────────────────
# 📱 Firebase Cloud Messaging (optional)
FCM_SERVER_KEY=your_fcm_server_key

# ─── Audit & Monitoring ───────────────────────────────────────────────────
# 📊 Security event logging and monitoring
AUDIT_LOG_RETENTION_DAYS=365
ENABLE_REQUEST_CORRELATION=true
METRICS_ENABLED=true

# ─── Rate Limiting Configuration ──────────────────────────────────────────
# 🚦 Enhanced rate limiting settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# User-specific rate limiting
USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX_REQUESTS=10

# ─── Session Management ───────────────────────────────────────────────────
# 🔄 Session and device tracking
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5

# ─── Security Headers ─────────────────────────────────────────────────────
# 🛡️  Content Security Policy and security headers
CSP_ENABLED=true
HSTS_MAX_AGE=31536000

# ─── Production Security Settings ─────────────────────────────────────────
# 🏭 Production-only settings (set these in production environment)
#
# HTTPS_REDIRECT=true
# SECURE_HEADERS=true
# TRUST_PROXY=true
# COMPRESSION=true
#
# ═══════════════════════════════════════════════════════════════════════════════
# 📖 SECURITY BEST PRACTICES:
#
# 1. 🔑 Generate unique secrets: Use crypto.randomBytes(32).toString('hex')
# 2. 🔐 Enable 2FA: Set up TOTP for admin accounts
# 3. 📊 Monitor logs: Check audit logs regularly
# 4. 🚦 Tune rate limits: Adjust based on your traffic patterns
# 5. 🔄 Rotate secrets: Change JWT secrets periodically
# 6. 📱 Test notifications: Verify FCM configuration
# 7. 🛡️  Use HTTPS: Enable TLS in production
# 8. 🔒 Secure Redis: Use password and encryption in production
# 9. 🗄️  Database security: Use MongoDB Atlas network access lists
# 10. 📈 Scale Redis: Consider Redis Cluster for high availability
# ═══════════════════════════════════════════════════════════════════════════════
